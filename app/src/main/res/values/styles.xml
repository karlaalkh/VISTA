<resources>
    <style name="Theme.Vista" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">
            #07111C
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @drawable/ic_vista_foreground
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.Vista.Main
        </item>
    </style>

    <style name="Theme.Vista.Main"
        parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#07111C</item>
        <item name="android:navigationBarColor">#07111C</item>
    </style>
</resources>